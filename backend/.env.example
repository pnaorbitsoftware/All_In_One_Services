PORT=5000
HOST=0.0.0.0
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/
# Old project alias also works if you already use it.
MONGODB_URI=
MONGO_DB_NAME=all_in_one_services
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
BCRYPT_SALT_ROUNDS=12

ADMIN_EMAIL=admin@servicehub.com
ADMIN_PASSWORD=change_this_admin_password

AUTH_REQUIRE_EMAIL_OTP=false
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ServiceHub

# Twilio SMS OTP. Required for real mobile OTP in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Old project alias also works as the SMS From number.
TWILIO_PHONE=

# For local/testing mobile OTP login only. Disable in production.
MOBILE_OTP_DEV_CODE=123456
ALLOW_DEV_OTP=true

CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ALLOW_MANUAL_PAYMENT_CONFIRMATION=false
PAYMENT_CURRENCY=INR
PROVIDER_SHARE_PERCENT=80

# Optional development-only provider login for local E2E tests.
SEED_TEST_ACCOUNTS=false
TEST_PROVIDER_EMAIL=provider.e2e@servicehub.local
TEST_PROVIDER_PASSWORD=change_this_test_password
