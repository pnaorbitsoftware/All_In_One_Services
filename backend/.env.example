PORT=5000
NODE_ENV=production

# MongoDB Atlas
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGO_DB_NAME=all_in_one_services

# Auth
JWT_SECRET=replace_with_a_long_random_secret
AUTH_REQUIRE_EMAIL_OTP=true
ADMIN_EMAIL=admin@servicehub.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Render/backend URL after deployment
CLIENT_URL=https://your-servicehub-backend.onrender.com
CORS_ORIGINS=https://your-servicehub-backend.onrender.com

# Brevo email OTP
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key
MAIL_FROM_EMAIL=your_verified_sender_email
MAIL_FROM_NAME=ServiceHub

# Optional payout calculation
PROVIDER_SHARE_PERCENT=80

# Local laptop-only DNS workaround. Do not add these on Render unless needed.
# MONGO_DNS_SERVERS=
# MONGO_DIRECT_HOSTS=
# MONGO_REPLICA_SET=
