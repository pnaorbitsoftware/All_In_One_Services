{
  "expo": {
    "name": "ServiceHub",
    "slug": "servicehub-aparaitech",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "servicehub",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.servicehub.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "./plugins/withCleartextTraffic",
      "@react-native-community/datetimepicker",
      "expo-location",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ServiceHub to select profile and Aadhaar images for upload."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://all-in-one-services.onrender.com/api",
      "eas": {
        "projectId": "52363804-9f97-4edd-b4a7-ab8401e1d27e"
      }
    },
    "owner": "nilesh5888",
    "ios": {
      "bundleIdentifier": "com.servicehub.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "ServiceHub uses your location only after permission to fill service addresses and share provider duty location with admin."
      }
    }
  }
}
