{
  "expo": {
    "name": "ServiceHub",
    "slug": "servicehub-mobile",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "servicehub",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.servicehub.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "./plugins/withCleartextTraffic",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "apiUrl": "https://servicehub-mobile-app.onrender.com/api",
      "eas": {
        "projectId": "13cf87d6-8411-4240-8d39-9152efdf9fc0"
      }
    },
    "owner": "kirantalekar99"
  }
}
