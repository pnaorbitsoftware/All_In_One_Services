{
    "expo":  {
                 "name":  "ServiceHub",
                 "slug":  "servicehub-mobile",
                 "version":  "1.0.0",
                 "icon":  "./assets/icon.png",
                 "orientation":  "default",
                 "userInterfaceStyle":  "automatic",
                 "scheme":  "servicehub",
                 "assetBundlePatterns":  [
                                             "**/*"
                                         ],
                 "android":  {
                                 "package":  "com.servicehub.mobile",
                                 "softwareKeyboardLayoutMode":  "resize",
                                 "permissions":  [
                                                     "ACCESS_COARSE_LOCATION",
                                                     "ACCESS_FINE_LOCATION"
                                                 ],
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./assets/adaptive-icon.png",
                                                      "backgroundColor":  "#0F766E"
                                                  }
                             },
                 "plugins":  [
                                 "expo-secure-store",
                                 "expo-font",
                                 "./plugins/withCleartextTraffic",
                                 "@react-native-community/datetimepicker",
                                 "expo-location",
                                 "expo-notifications",
                                 [
                                     "expo-splash-screen",
                                     {
                                         "backgroundColor":  "#0F766E",
                                         "image":  "./assets/icon.png",
                                         "imageWidth":  120
                                     }
                                 ]
                             ],
                 "extra":  {
                               "apiUrl":  "http://10.0.2.2:5000/api",
                               "eas":  {
                                           "projectId":  "13cf87d6-8411-4240-8d39-9152efdf9fc0"
                                       }
                           },
                 "owner":  "kirantalekar99",
                 "ios":  {
                             "bundleIdentifier":  "com.servicehub.mobile",
                             "infoPlist":  {
                                               "ITSAppUsesNonExemptEncryption":  false,
                                               "NSLocationWhenInUseUsageDescription":  "ServiceHub uses your location only after permission to fill service addresses and share provider duty location with admin."
                                           }
                         }
             }
}
